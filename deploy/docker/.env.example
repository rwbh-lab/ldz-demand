# Copy to deploy/docker/.env (git-ignored) and set for this host. Paths are on the host running Docker.
RAW_DIR=/path/to/ldz-demand/raw         # raw archive: National Gas CSVs, ERA5 NetCDF, ensemble GRIB
DB_ENV=/path/to/db.env                  # LDZ_DB_HOST, LDZ_DB_PORT, LDZ_DB_NAME, LDZ_DB_USER, LDZ_DB_PASSWORD
CDS_ENV=/path/to/cds.env                # CDSAPI_URL=https://cds.climate.copernicus.eu/api, CDSAPI_KEY=<token>
# LDZ_IMAGE=ldz-demand:latest
