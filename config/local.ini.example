# Copy to config/local.ini and edit. local.ini is gitignored.
# Only keys you want to change from default.ini are needed.

[storage]
# true -> processed tables go to MySQL (connection details in .env, see .env.example)
database = true
# Raw downloads (National Gas CSVs, ERA5 NetCDF, ECMWF GRIB) — e.g. a mounted NAS share
raw_dir = /Volumes/<share>/ldz-demand/raw
