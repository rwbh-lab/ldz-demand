# MySQL connection for the database store (database = true in config/local.ini).
# Copy to .env in the repo root and fill in. .env is gitignored — never commit it.
# Not needed for the default CSV cache (database = false).

# Host selection:
#   LDZ_DB_HOST          if set, always used (single-host setups). Leave unset to use LOCAL/REMOTE.
#   LDZ_DB_HOST_LOCAL    LAN address, e.g. the NAS IP on your home network
#   LDZ_DB_HOST_REMOTE   address that works from anywhere, e.g. a Tailscale IP / MagicDNS name
#   LDZ_DB_NETWORK       auto (default) | local | remote
#                        auto: try LOCAL briefly, fall back to REMOTE
#   LDZ_DB_HOME_GATEWAY  optional: your home router IP; auto only tries LOCAL when on that network
# LDZ_DB_HOST=
LDZ_DB_HOST_LOCAL=
LDZ_DB_HOST_REMOTE=
LDZ_DB_NETWORK=auto
# LDZ_DB_HOME_GATEWAY=
LDZ_DB_PORT=3306
LDZ_DB_NAME=ldz_demand
LDZ_DB_USER=ldz_app
LDZ_DB_PASSWORD=
